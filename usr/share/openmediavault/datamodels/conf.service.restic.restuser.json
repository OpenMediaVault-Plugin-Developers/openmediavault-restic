{
  "type": "config",
  "id": "conf.service.restic.restuser",
  "title": "Restic REST server user",
  "queryinfo": {
    "xpath": "//services/restic/restusers/restuser",
    "iterable": true,
    "idproperty": "uuid"
  },
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuidv4"
    },
    "username": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "passwordhash": {
      "type": "string",
      "default": ""
    }
  }
}
