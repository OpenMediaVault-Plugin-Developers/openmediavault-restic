{
  "type": "config",
  "id": "conf.service.restic.repo",
  "title": "Restic repository",
  "queryinfo": {
    "xpath": "//services/restic/repos/repo",
    "iterable": true,
    "idproperty": "uuid"
  },
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuidv4"
    },
    "name": {
      "type": "string"
    },
    "passphrase": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "local",
        "s3",
        "sftp",
        "b2",
        "rest",
        "rclone"
      ],
      "default": "local"
    },
    "sharedfolderref": {
      "type": "string",
      "oneOf": [
        {
          "type": "string",
          "format": "uuidv4"
        },
        {
          "type": "string",
          "maxLength": 0
        }
      ],
      "default": ""
    },
    "uri": {
      "type": "string",
      "default": ""
    },
    "accesskey": {
      "type": "string",
      "default": ""
    },
    "secretkey": {
      "type": "string",
      "default": ""
    },
    "connections": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "options": {
      "type": "string",
      "default": ""
    },
    "checkschedule": {
      "type": "string",
      "enum": [
        "disabled",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "disabled"
    },
    "checkreaddata": {
      "type": "string",
      "default": ""
    },
    "checkemail": {
      "type": "string",
      "enum": [
        "never",
        "always",
        "onerror"
      ],
      "default": "onerror"
    },
    "forgetschedule": {
      "type": "string",
      "enum": ["disabled", "daily", "weekly", "monthly"],
      "default": "disabled"
    },
    "forgetkeeplast": {
      "type": "integer",
      "default": 0
    },
    "forgetkeepdaily": {
      "type": "integer",
      "default": 7
    },
    "forgetkeepweekly": {
      "type": "integer",
      "default": 4
    },
    "forgetkeepmonthly": {
      "type": "integer",
      "default": 12
    },
    "forgetkeepyearly": {
      "type": "integer",
      "default": 0
    },
    "forgethost": {
      "type": "string",
      "default": ""
    },
    "forgettag": {
      "type": "string",
      "default": ""
    },
    "forgetprune": {
      "type": "boolean",
      "default": true
    },
    "forgetemail": {
      "type": "string",
      "enum": ["never", "always", "onerror"],
      "default": "onerror"
    }
  }
}
