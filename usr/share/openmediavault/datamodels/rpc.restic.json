[
  {
    "type": "rpc",
    "id": "rpc.restic.setsettings",
    "params": {
      "type": "object",
      "properties": {
        "cachedir": {
          "type": "string",
          "required": true
        },
        "exclude": {
          "type": "string"
        },
        "excludecaches": {
          "type": "boolean"
        }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.restic.setrepo",
    "params": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuidv4",
          "required": true
        },
        "name": {
          "type": "string",
          "pattern": "^[^\\x00-\\x1f]*\\z",
          "required": true
        },
        "type": {
          "type": "string",
          "enum": [
            "local",
            "s3",
            "sftp",
            "b2",
            "rest",
            "rclone"
          ],
          "required": true
        },
        "sharedfolderref": {
          "type": "string",
          "oneOf": [
            {
              "type": "string",
              "format": "uuidv4"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ],
          "required": true
        },
        "passphrase": {
          "type": "string",
          "required": true
        },
        "uri": {
          "type": "string"
        },
        "accesskey": {
          "type": "string"
        },
        "secretkey": {
          "type": "string"
        },
        "skipinit": {
          "type": "boolean",
          "required": true
        },
        "checkschedule": {
          "type": "string",
          "enum": ["disabled", "daily", "weekly", "monthly"]
        },
        "checkreaddata": {
          "type": "string",
          "pattern": "^\\z|^([1-9][0-9]?(\\.[0-9]+)?|100)%\\z|^[1-9][0-9]*\\/[1-9][0-9]*\\z|^[1-9][0-9]*[KMGT]?\\z"
        },
        "checkemail": {
          "type": "string",
          "enum": ["never", "always", "onerror"]
        },
        "forgetschedule": {
          "type": "string",
          "enum": ["disabled", "daily", "weekly", "monthly"]
        },
        "forgetkeeplast": {
          "type": "integer",
          "minimum": 0
        },
        "forgetkeepdaily": {
          "type": "integer",
          "minimum": 0
        },
        "forgetkeepweekly": {
          "type": "integer",
          "minimum": 0
        },
        "forgetkeepmonthly": {
          "type": "integer",
          "minimum": 0
        },
        "forgetkeepyearly": {
          "type": "integer",
          "minimum": 0
        },
        "forgethost": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]*\\z"
        },
        "forgettag": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:=@+-]*\\z"
        },
        "forgetprune": {
          "type": "boolean"
        },
        "forgetemail": {
          "type": "string",
          "enum": ["never", "always", "onerror"]
        }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.restic.setsnapshot",
    "params": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuidv4",
          "required": true
        },
        "enable": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[^\\x00-\\x1f]*\\z"
        },
        "hash": {
          "type": "string",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ],
          "required": true
        },
        "tags": {
          "type": "string",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ],
          "required": true
        },
        "sharedfolderrefs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuidv4"
          },
          "required": true
        },
        "reporef": {
          "type": "string",
          "format": "uuidv4",
          "required": true
        },
        "exclude": {
          "type": "string",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ],
          "required": true
        },
        "execution": {
          "type": "string",
          "enum": ["exactly", "hourly", "daily", "weekly", "monthly", "yearly", "reboot"],
          "required": true
        },
        "minute": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*|[0-9]{1,2})\\z" },
          "required": true
        },
        "everynminute": {
          "type": "boolean",
          "required": true
        },
        "hour": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*|[0-9]{1,2})\\z" },
          "required": true
        },
        "everynhour": {
          "type": "boolean",
          "required": true
        },
        "dayofmonth": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*|[0-9]{1,2})\\z" },
          "required": true
        },
        "everyndayofmonth": {
          "type": "boolean",
          "required": true
        },
        "month": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*|[0-9]{1,2})\\z" },
          "required": true
        },
        "dayofweek": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*|[0-9]{1,2})\\z" },
          "required": true
        },
        "keeplast": {
          "type": "integer"
        },
        "keepdaily": {
          "type": "integer"
        },
        "keepweekly": {
          "type": "integer"
        },
        "keepmonthly": {
          "type": "integer"
        },
        "keepyearly": {
          "type": "integer"
        },
        "sendemail": {
          "type": "boolean"
        },
        "emailonerror": {
          "type": "boolean"
        },
        "prescript": {
          "type": "string"
        },
        "postscript": {
          "type": "string"
        }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.restic.setenvvar",
