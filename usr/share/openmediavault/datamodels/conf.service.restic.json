{
  "type": "config",
  "id": "conf.service.restic",
  "title": "Restic",
  "queryinfo": {
    "xpath": "//services/restic",
    "iterable": false
  },
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "cachedir": {
          "type": "string",
          "default": "/var/cache/restic"
        },
        "exclude": {
          "type": "string",
          "default": ""
        },
        "excludecaches": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "repos": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "name": {
                "type": "string"
              },
              "passphrase": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "local",
                  "s3",
                  "sftp",
                  "b2",
                  "rest",
                  "rclone"
                ],
                "default": "local"
              },
              "sharedfolderref": {
                "type": "string",
                "default": ""
              },
              "uri": {
                "type": "string",
                "default": ""
              },
              "accesskey": {
                "type": "string",
                "default": ""
              },
              "secretkey": {
                "type": "string",
                "default": ""
              },
              "connections": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "options": {
                "type": "string",
                "default": ""
              },
              "checkschedule": {
                "type": "string",
                "enum": [
                  "disabled",
                  "daily",
                  "weekly",
                  "monthly"
                ],
                "default": "disabled"
              },
              "checkreaddata": {
                "type": "string",
                "default": ""
              },
              "checkemail": {
                "type": "string",
                "enum": [
                  "never",
                  "always",
                  "onerror"
                ],
                "default": "onerror"
              },
              "forgetschedule": {
                "type": "string",
                "enum": ["disabled", "daily", "weekly", "monthly"],
                "default": "disabled"
              },
              "forgetkeeplast": {
                "type": "integer",
                "default": 0
              },
              "forgetkeepdaily": {
                "type": "integer",
                "default": 7
              },
              "forgetkeepweekly": {
                "type": "integer",
                "default": 4
              },
              "forgetkeepmonthly": {
                "type": "integer",
                "default": 12
              },
              "forgetkeepyearly": {
                "type": "integer",
                "default": 0
              },
              "forgethost": {
                "type": "string",
                "default": ""
              },
              "forgettag": {
                "type": "string",
                "default": ""
              },
              "forgetprune": {
                "type": "boolean",
                "default": true
              },
              "forgetemail": {
                "type": "string",
                "enum": ["never", "always", "onerror"],
                "default": "onerror"
              }
            }
          }
        }
      }
    },
    "snapshots": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "enable": {
                "type": "boolean",
                "default": true
              },
              "name": {
                "type": "string",
                "default": ""
              },
              "hash": {
                "type": "string",
                "default": ""
              },
              "tags": {
                "type": "string",
                "default": ""
              },
              "csvsharedfolderrefs": {
                "type": "string",
                "default": ""
              },
              "reporef": {
                "type": "string",
                "format": "uuidv4"
              },
              "exclude": {
                "type": "string",
                "default": ""
              },
              "execution": {
                "type": "string",
                "default": "daily"
              },
              "minute": {
                "type": "string",
                "default": "0"
              },
              "everynminute": {
                "type": "boolean",
                "default": false
              },
              "hour": {
                "type": "string",
                "default": "0"
              },
              "everynhour": {
                "type": "boolean",
                "default": false
              },
              "dayofmonth": {
                "type": "string",
                "default": "*"
              },
              "everyndayofmonth": {
                "type": "boolean",
                "default": false
              },
              "month": {
                "type": "string",
                "default": "*"
              },
              "dayofweek": {
                "type": "string",
                "default": "*"
              },
              "keeplast": {
                "type": "integer",
                "default": 0
              },
              "keepdaily": {
                "type": "integer",
                "default": 7
              },
              "keepweekly": {
                "type": "integer",
                "default": 4
              },
              "keepmonthly": {
                "type": "integer",
                "default": 12
              },
              "keepyearly": {
                "type": "integer",
                "default": 0
              },
              "sendemail": {
                "type": "boolean",
                "default": false
              },
              "emailonerror": {
                "type": "boolean",
                "default": false
              },
              "prescript": {
                "type": "string",
                "default": ""
              },
              "postscript": {
                "type": "string",
                "default": ""
              },
              "excludelist": {
                "type": "string",
                "default": ""
              },
              "fileslist": {
                "type": "string",
                "default": ""
              }
            }
          }
        }
      }
    },
    "restoretests": {
      "type": "object",
      "properties": {
        "restoretest": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "enable": {
                "type": "boolean",
                "default": true
              },
              "name": {
                "type": "string",
                "default": ""
              },
              "reporef": {
                "type": "string",
                "format": "uuidv4"
              },
              "mode": {
                "type": "string",
                "default": "dryrun"
              },
              "targetref": {
                "type": "string",
                "default": ""
              },
              "cleanup": {
                "type": "boolean",
                "default": true
              },
              "includepath": {
                "type": "string",
                "default": ""
              },
              "execution": {
                "type": "string",
                "default": "weekly"
              },
              "minute": {
                "type": "string",
                "default": "0"
              },
              "everynminute": {
                "type": "boolean",
                "default": false
              },
              "hour": {
                "type": "string",
                "default": "0"
              },
              "everynhour": {
                "type": "boolean",
                "default": false
              },
              "dayofmonth": {
                "type": "string",
                "default": "*"
              },
              "everyndayofmonth": {
                "type": "boolean",
                "default": false
              },
              "month": {
                "type": "string",
                "default": "*"
              },
              "dayofweek": {
                "type": "string",
                "default": "*"
              },
              "sendemail": {
                "type": "boolean",
                "default": false
              },
              "emailonerror": {
                "type": "boolean",
                "default": false
              },
              "prescript": {
                "type": "string",
                "default": ""
              },
              "postscript": {
                "type": "string",
                "default": ""
              }
            }
          }
        }
      }
    },
    "envvars": {
      "type": "object",
      "properties": {
        "envvar": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "envname": {
                "type": "string"
              },
              "envvalue": {
                "type": "string"
              },
              "reporef": {
                "type": "string",
                "oneOf": [
                  {
                    "type": "string",
                    "format": "uuidv4"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "shared"
                    ]
                  },
                  {
                    "type": "string",
                    "maxLength": 0
                  }
                ],
                "default": ""
              }
            }
          }
        }
      }
    },
    "restserver": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        },
        "sharedfolderref": {
          "type": "string",
          "default": ""
        },
        "port": {
          "type": "integer",
          "default": 8000
        },
        "auth": {
          "type": "boolean",
          "default": true
        },
        "privaterepos": {
          "type": "boolean",
          "default": false
        },
        "appendonly": {
          "type": "boolean",
          "default": false
        },
        "tls": {
          "type": "boolean",
          "default": false
        },
        "sslcertificateref": {
          "type": "string",
          "default": ""
        }
      }
    },
    "restusers": {
      "type": "object",
      "properties": {
        "restuser": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "username": {
                "type": "string"
              },
              "passwordhash": {
                "type": "string",
                "default": ""
              }
            }
          }
        }
      }
    }
  }
}
