{
  "type": "config",
  "id": "conf.service.restic.restserver",
  "title": "Restic REST server",
  "queryinfo": {
    "xpath": "//services/restic/restserver",
    "iterable": false
  },
  "properties": {
    "enable": {
      "type": "boolean",
      "default": false
    },
    "sharedfolderref": {
      "type": "string",
      "oneOf": [
        {
          "type": "string",
          "format": "uuidv4"
        },
        {
          "type": "string",
          "maxLength": 0
        }
      ],
      "default": ""
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8000
    },
    "auth": {
      "type": "boolean",
      "default": true
    },
    "privaterepos": {
      "type": "boolean",
      "default": false
    },
    "appendonly": {
      "type": "boolean",
      "default": false
    },
    "tls": {
      "type": "boolean",
      "default": false
    },
    "sslcertificateref": {
      "type": "string",
      "oneOf": [
        {
          "type": "string",
          "format": "uuidv4"
        },
        {
          "type": "string",
          "maxLength": 0
        }
      ],
      "default": ""
    }
  }
}
