class OMVRpcServiceRestic extends \OMV\Rpc\ServiceAbstract
{
    private $getProgram = '/usr/bin/restic';
    private $envFile = '/etc/restic/restic-envvar-';
    private $defaultExcludeFile = '/etc/restic/exclude-default';

    public function getName()
    {
        return "Restic";
    }

    public function initialize()
    {
        // Settings
        $this->registerMethod("getSettings");
        $this->registerMethod("setSettings");

        // Repositories
        $this->registerMethod("getRepoList");
        $this->registerMethod("enumerateRepoCandidates");
        $this->registerMethod("getRepo");
        $this->registerMethod("setRepo");
        $this->registerMethod("deleteRepo");
        $this->registerMethod("checkRepo");
        $this->registerMethod("pruneRepo");
        $this->registerMethod("unlockRepo");
        $this->registerMethod("testRepo");
        $this->registerMethod("getRepoStats");
        $this->registerMethod("getRepoSnapshotList");
        $this->registerMethod("inspectRepoSnapshot");
        $this->registerMethod("listRepoSnapshotFiles");
        $this->registerMethod("forgetRepoSnapshots");
        $this->registerMethod("applyRepoForget");

        // Backup jobs (referred to as "snapshots" for backward compatibility)
        $this->registerMethod("getSnapshotList");
        $this->registerMethod("getSnapshot");
        $this->registerMethod("setSnapshot");
        $this->registerMethod("deleteSnapshot");
        $this->registerMethod("runSnapshot");

        // Restore
        $this->registerMethod("restoreSnapshot");

        // Restore test jobs (scheduled dry-run / verify restores)
        $this->registerMethod("getRestoreTestList");
        $this->registerMethod("getRestoreTest");
        $this->registerMethod("setRestoreTest");
        $this->registerMethod("deleteRestoreTest");
        $this->registerMethod("runRestoreTest");

        // REST server
        $this->registerMethod('getRestServer');
        $this->registerMethod('setRestServer');
        $this->registerMethod('getRestUserList');
        $this->registerMethod('getRestUser');
        $this->registerMethod('setRestUser');
        $this->registerMethod('deleteRestUser');

        // Environment variables
        $this->registerMethod('getEnvVarList');
        $this->registerMethod('getEnvVar');
        $this->registerMethod('setEnvVar');
        $this->registerMethod('deleteEnvVar');
    }

    // =========================================================================
    // Settings
    // =========================================================================

    public function getSettings($params, $context)
    {
        $this->validateMethodContext($context, ["role" => OMV_ROLE_ADMINISTRATOR]);
        $db = \OMV\Config\Database::getInstance();
        $object = $db->get("conf.service.restic.settings");
        return $object->getAssoc();
    }

    public function setSettings($params, $context)
    {
        $this->validateMethodContext($context, ["role" => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.setsettings');
        $db = \OMV\Config\Database::getInstance();
        $object = $db->get("conf.service.restic.settings");
        $object->setFlatAssoc([
            "cachedir" => $params['cachedir'],
            "exclude" => $params['exclude'] ?? $object->get('exclude'),
            "excludecaches" => $params['excludecaches'] ?? $object->get('excludecaches'),
        ]);
        $db->set($object);
        return $object->getAssoc();
    }

    // =========================================================================
    // Helper: configure environment for a repository
    // =========================================================================

    /**
     * Set RESTIC_PASSWORD and RESTIC_REPOSITORY (plus backend credentials)
     * as environment variables on a Process object, on top of the user's
     * environment variables. The precedence matches the scheduled scripts
     * generated by salt: shared < repository-specific < the plugin's own
     * values (a later setEnv() replaces an earlier one).
     *
     * IMPORTANT: \OMV\System\Process::getCommandLine() emits each variable as
     * an unquoted `export NAME=value;` shell statement, so values MUST be
     * passed through escapeshellarg() here. Omitting it breaks any value that
     * contains whitespace or shell metacharacters and allows shell injection.
     */
    private function buildRepoEnv($repo, $context, &$cmd)
    {
        $cmd->setEnvFromFile($this->envFile . 'shared');
        $cmd->setEnvFromFile($this->envFile . $repo->get('uuid'));

        $type = $repo->get('type');

        // Password is always required
        $cmd->setEnv("RESTIC_PASSWORD", escapeshellarg($repo->get('passphrase')));

        switch ($type) {
            case 'local':
                $path = \OMV\Rpc\Rpc::call('ShareMgmt', 'getPath', [
                    'uuid' => $repo->get('sharedfolderref')
                ], $context);
                $cmd->setEnv("RESTIC_REPOSITORY", escapeshellarg($path));
                break;

            case 's3':
                $cmd->setEnv("RESTIC_REPOSITORY", escapeshellarg('s3:' . $repo->get('uri')));
                $cmd->setEnv("AWS_ACCESS_KEY_ID", escapeshellarg($repo->get('accesskey')));
                $cmd->setEnv("AWS_SECRET_ACCESS_KEY", escapeshellarg($repo->get('secretkey')));
                break;

            case 'b2':
                $cmd->setEnv("RESTIC_REPOSITORY", escapeshellarg('b2:' . $repo->get('uri')));
                $cmd->setEnv("B2_ACCOUNT_ID", escapeshellarg($repo->get('accesskey')));
                $cmd->setEnv("B2_ACCOUNT_KEY", escapeshellarg($repo->get('secretkey')));
                break;

            case 'sftp':
                $cmd->setEnv("RESTIC_REPOSITORY", escapeshellarg('sftp:' . $repo->get('uri')));
                break;

            case 'rest':
                $cmd->setEnv("RESTIC_REPOSITORY", escapeshellarg('rest:' . $repo->get('uri')));
                break;

            case 'rclone':
                // The rclone remote must be configured out of band via `rclone config`.
                $cmd->setEnv("RESTIC_REPOSITORY", escapeshellarg('rclone:' . $repo->get('uri')));
                break;

            default:
                // Custom/other: use URI as-is
                $cmd->setEnv("RESTIC_REPOSITORY", escapeshellarg($repo->get('uri')));
                break;
        }

        $settings = \OMV\Config\Database::getInstance()->get("conf.service.restic.settings");
        $cacheDir = $settings->get("cachedir");
        if (!empty($cacheDir)) {
            $cmd->setEnv("RESTIC_CACHE_DIR", escapeshellarg($cacheDir));
        }
    }

    /**
     * Human-readable form of a restic command for task output and error
     * messages. It deliberately leaves out the environment, which holds the
     * repository password, backend keys and any user-defined variables
     * (\OMV\System\Process::getCommandLine() would print them all).
     */
    private function displayCommand(array $cmdArgs)
    {
        return implode(' ', $cmdArgs);
    }

    /**
     * Parse a repository's extended options: one `backend.option=value` per
     * line, blank lines ignored. Throws on a malformed line. Must match the
     * parsing in default.sls.
     */
    private function parseRepoOptions($text)
    {
        $opts = [];
        foreach (preg_split('/\r\n|\r|\n/', $text ?? '') as $line) {
            $line = trim($line);
            if ($line === '') {
                continue;
            }
            if (!preg_match('/^[a-z0-9]+\.[a-z0-9-]+=[^\x00-\x1f\x7f]*\z/', $line)) {
                throw new \OMV\Exception(sprintf(gettext(
                    "Invalid restic option '%s'. Use one backend.option=value per line, e.g. s3.region=us-east-1."),
                    $line));
            }
            $opts[] = $line;
        }
        return $opts;
    }

    /**
     * The `-o` arguments of a repository: the connection limit for its
     * backend type plus any extended options, each shell-quoted.
     */
    private function buildRepoOptions($repo)
    {
        $opts = [];
        $connections = intval($repo->get('connections'));
        if ($connections > 0) {
            $opts[] = $repo->get('type') . '.connections=' . $connections;
        }
        $args = [];
        foreach (array_merge($opts, $this->parseRepoOptions($repo->get('options'))) as $opt) {
            $args[] = '-o ' . escapeshellarg($opt);
        }
        return $args;
    }

    /**
     * Insert the repository's `-o` arguments after the program and the
     * restic subcommand of $cmdArgs.
     */
    private function addRepoOptions($repo, array $cmdArgs)
    {
        array_splice($cmdArgs, 2, 0, $this->buildRepoOptions($repo));
        return $cmdArgs;
    }

    /**
     * The entries of a backup job's one-per-line list (advanced exclude
     * patterns or files-from paths): trimmed, without blank and # comment
     * lines. Must match the parsing in restic-job.sh.j2.
     */
    private function parseJobList($text)
    {
        $entries = [];
        foreach (preg_split('/\r\n|\r|\n/', $text ?? '') as $line) {
            $line = trim($line);
            if ($line !== '' && $line[0] !== '#') {
                $entries[] = $line;
            }
        }
        return $entries;
    }

    /**
     * Tag added to the snapshots of a backup job without source folders, so
     * its retention policy can be scoped to them (there are no fixed --path
     * values to scope by). Must match restic-job.sh.j2.
     */
    private function jobTag($uuid)
    {
        return 'omv-job-' . $uuid;
    }

    /**
     * Run a job's pre/post hook command via /bin/sh -c with the repository
     * environment, so it matches the scheduled scripts generated by salt.
     * Returns the exit code (0 when no hook is configured).
     */
    private function runHookScript($label, $script, $repo, $context, $bgOutputFilename, $jobExit = null)
    {
        $script = trim($script ?? '');
        if ($script === '') {
            return 0;
        }
        $cmd = new \OMV\System\Process(['/bin/sh', '-c', escapeshellarg($script)]);
        $this->buildRepoEnv($repo, $context, $cmd);
        if ($jobExit !== null) {
            $cmd->setEnv('RESTIC_JOB_EXIT', escapeshellarg(strval($jobExit)));
        }
        $cmd->setRedirect2to1();
        $this->writeBgProcOutput($bgOutputFilename, sprintf("\nRunning %s ...\n\n", $label));
        $rc = $this->exec($cmd->getCommandLine(), $output, $bgOutputFilename);
        if ($rc !== 0) {
            $this->writeBgProcOutput($bgOutputFilename,
                sprintf("\n%s failed with exit code %d\n", ucfirst($label), $rc));
        }
        return $rc;
    }

    /**
     * Apply a retention policy via `restic forget --prune`.
     * Called after a successful backup. Only runs if any keep-* value > 0.
     * A failure is reported in the task output but does not fail the job,
     * matching the scheduled script.
     */
    private function applyRetentionPolicy($params, $repo, $context, $bgOutputFilename)
    {
        $keepLast    = isset($params['keeplast'])    ? intval($params['keeplast'])    : 0;
        $keepDaily   = isset($params['keepdaily'])   ? intval($params['keepdaily'])   : 0;
        $keepWeekly  = isset($params['keepweekly'])  ? intval($params['keepweekly'])  : 0;
        $keepMonthly = isset($params['keepmonthly']) ? intval($params['keepmonthly']) : 0;
        $keepYearly  = isset($params['keepyearly'])  ? intval($params['keepyearly'])  : 0;

        if ($keepLast + $keepDaily + $keepWeekly + $keepMonthly + $keepYearly === 0) {
            return;
        }

        $forgetArgs = [$this->getProgram, 'forget', '--prune', '--retry-lock', '5m'];
        if ($keepLast    > 0) $forgetArgs[] = '--keep-last '    . $keepLast;
        if ($keepDaily   > 0) $forgetArgs[] = '--keep-daily '   . $keepDaily;
        if ($keepWeekly  > 0) $forgetArgs[] = '--keep-weekly '  . $keepWeekly;
        if ($keepMonthly > 0) $forgetArgs[] = '--keep-monthly ' . $keepMonthly;
        if ($keepYearly  > 0) $forgetArgs[] = '--keep-yearly '  . $keepYearly;

        // Scope to this job's source paths so retention does not affect
        // snapshots from other backup jobs sharing the same repository. A
        // job backing up only an include list is scoped by its tag.
        if (empty($params['sharedfolderrefs'])) {
            $forgetArgs[] = '--tag ' . escapeshellarg($this->jobTag($params['uuid']));
        }
        foreach ($params['sharedfolderrefs'] as $uuid) {
            try {
                $sfpath = \OMV\Rpc\Rpc::call("ShareMgmt", "getPath", ["uuid" => $uuid], $context);
                $forgetArgs[] = '--path ' . escapeshellarg($sfpath);
            } catch (\Exception $e) {
                // skip unresolvable paths
            }
        }

        $forgetArgs = $this->addRepoOptions($repo, $forgetArgs);
        $forgetCmd = new \OMV\System\Process($forgetArgs);
        $this->buildRepoEnv($repo, $context, $forgetCmd);
        $forgetCmd->setRedirect2to1();
        $forgetCmdLine = $forgetCmd->getCommandLine();
        $this->writeBgProcOutput($bgOutputFilename, sprintf(
            "\n\nApplying retention policy: %s\n\n",
            $this->displayCommand($forgetArgs)
        ));
        $forgetExit = $this->exec($forgetCmdLine, $output, $bgOutputFilename);
        if ($forgetExit !== 0) {
            $this->writeBgProcOutput($bgOutputFilename, sprintf(
                "\nWARNING: Retention policy application failed with exit code %d\n",
                $forgetExit));
        }
    }

    /**
     * Build the cron expression of a backup job or restore test, for display
     * (fed to cron2human in the UI). Must match the logic in default.sls.
     */
    private function buildCronSchedule(array $job, $defaultExecution)
    {
        switch ($job['execution'] ?? $defaultExecution) {
            case 'hourly':  return '0 * * * *';
            case 'daily':   return '0 0 * * *';
            case 'weekly':  return '0 0 * * 0';
            case 'monthly': return '0 0 1 * *';
            case 'yearly':  return '0 0 1 1 *';
            case 'reboot':  return '@reboot';
        }
        // exactly: "every N" only applies to a single positive number, as
        // `*/0`, `*/*` or `*/1,2` are not valid cron fields.
        $field = function ($value, $everyN) {
            $value = strval($value);
            return ($everyN && ctype_digit($value) && intval($value) > 0)
                ? '*/' . $value : $value;
        };
        return implode(' ', [
            $field($job['minute'], $job['everynminute']),
            $field($job['hour'], $job['everynhour']),
            $field($job['dayofmonth'], $job['everyndayofmonth']),
            $job['month'],
            $job['dayofweek'],
        ]);
    }

    /**
     * Convert the schedule multi-select arrays of a backup job or restore
     * test to comma-separated strings for storage, and reject an "every N"
     * schedule that does not name exactly one positive number.
     */
    private function normaliseSchedule(array &$params)
    {
        foreach (['minute', 'hour', 'dayofmonth', 'month', 'dayofweek'] as $field) {
            if (is_array($params[$field])) {
                $params[$field] = implode(',', $params[$field]);
            }
        }
        if (($params['execution'] ?? '') !== 'exactly') {
            return;
        }
        $labels = [
            'minute' => gettext('minute'),
            'hour' => gettext('hour'),
            'dayofmonth' => gettext('day of month'),
        ];
        foreach ($labels as $field => $label) {
            if (!empty($params['everyn' . $field]) &&
                    (!ctype_digit(strval($params[$field])) || intval($params[$field]) === 0)) {
                throw new \OMV\Exception(sprintf(gettext(
                    "'Every N %s' needs exactly one value greater than 0."), $label));
            }
        }
    }

    // =========================================================================
    // Repositories
    // =========================================================================

    public function getRepoList($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.getlist');

        $db = \OMV\Config\Database::getInstance();
        $repos = $db->get('conf.service.restic.repo');
        $snapshots = $db->get('conf.service.restic.snapshot');

        $objectsAssoc = [];
        foreach ($repos as $repok => &$repov) {
            $repov->add('sharedfoldername', 'string', gettext("n/a"));
            if ($repov->get('type') === 'local' && !empty($repov->get('sharedfolderref'))) {
                try {
                    $sfObject = $db->get('conf.system.sharedfolder', $repov->get('sharedfolderref'));
                    $repov->set('sharedfoldername', $sfObject->get('name'));
                } catch (\Exception $e) {}
            }
            $snapshotCount = 0;
            foreach ($snapshots as $snapshotv) {
                if ($snapshotv->get('reporef') == $repov->get('uuid')) {
                    $snapshotCount++;
                }
            }
            $repov->add('snapshotCount', 'integer', $snapshotCount);
            $objectsAssoc[] = $repov->getAssoc();
        }
        return $this->applyFilter(
            $objectsAssoc, $params['start'], $params['limit'],
            $params['sortfield'], $params['sortdir']
        );
    }

    public function enumerateRepoCandidates($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $db = \OMV\Config\Database::getInstance();
        $repos = $db->getAssoc('conf.service.restic.repo');
        if (!empty($params['shared'])) {
            $repos[] = ['name' => 'All Repositories', 'uuid' => 'shared'];
        }
        return $repos;
    }

    public function getRepo($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');
        $db = \OMV\Config\Database::getInstance();
        return $db->getAssoc('conf.service.restic.repo', $params['uuid']);
    }

    public function setRepo($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.setrepo');

        $type = $params['type'];
        $params['name'] = str_replace(' ', '_', $params['name']);
        if ($type === 'local' && empty($params['sharedfolderref'])) {
            throw new \OMV\Exception(gettext('A local repository requires a shared folder.'));
        }

        $repo = new \OMV\Config\ConfigObject('conf.service.restic.repo');
        $db = \OMV\Config\Database::getInstance();
        $skipinit = $params['skipinit'];
        unset($params['skipinit']);
        $repo->setAssoc($params);

        $options = $this->parseRepoOptions($repo->get('options'));
        $connKey = $type . '.connections=';
        if (intval($repo->get('connections')) > 0) {
            foreach ($options as $opt) {
                if (strpos($opt, $connKey) === 0) {
                    throw new \OMV\Exception(sprintf(gettext(
                        "'%s' is set twice. Use either the Connections field or the extended options."),
                        rtrim($connKey, '=')));
                }
            }
        }

        // A retention schedule without any keep rule would silently do nothing.
        if ($repo->get('forgetschedule') !== 'disabled' && is_null($this->buildRepoForgetArgs($repo))) {
            throw new \OMV\Exception(gettext(
                'Scheduled retention requires at least one keep value greater than 0.'));
        }

        // Also on edit, as the form lets both be changed. isUnique() leaves
        // the edited object itself out of the comparison.
        $db->assertIsUnique($repo, 'name');
        // Only assert unique shared folder for local repos
        if ($type === 'local') {
            $db->assertIsUnique($repo, 'sharedfolderref');
        }

        $isNew = $repo->isNew();
        if (!$isNew) {
            // A restic repository's encryption password cannot be changed by
            // rewriting config - it must be rotated with `restic key passwd`.
            // Silently rewriting it here would orphan the repository, so we
            // always preserve the stored passphrase on edit.
            $existing = $db->get('conf.service.restic.repo', $repo->get('uuid'));
            $repo->set('passphrase', $existing->get('passphrase'));
        }

        // Initialise only for new repos (unless skipped)
        if ($isNew && !$skipinit) {
            $cmdArgs = $this->addRepoOptions($repo, [$this->getProgram, 'init']);
            $cmd = new \OMV\System\Process($cmdArgs);
            $this->buildRepoEnv($repo, $context, $cmd);
            $cmd->setRedirect2to1();
            $cmdLine = $cmd->getCommandLine();
            $cmd->execute($output, $exitStatus);
            if (0 !== $exitStatus) {
                throw new \OMV\ExecException($this->displayCommand($cmdArgs), $output, $exitStatus);
            }
        }

        $db->set($repo);
        return $repo->getAssoc();
    }

    /**
     * Remove a repository from the configuration. The repository data is
     * kept unless `deletedata` is set, so a repository can be removed and
     * imported again later. Only the data of a local repository is ever
     * deleted; remote repositories are never touched.
     */
    public function deleteRepo($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.deleterepo');

        $db = \OMV\Config\Database::getInstance();

        // Ensure no backup jobs reference this repo
        $snapshots = $db->get('conf.service.restic.snapshot');
        foreach ($snapshots as $snapshot) {
            if ($snapshot->get('reporef') == $params['uuid']) {
                throw new \OMV\Exception(gettext(
                    "Repository is in use. Please delete the backup jobs associated with this repository first."
                ));
            }
        }

        // Ensure no restore test jobs reference this repo
        $restoretests = $db->get('conf.service.restic.restoretest');
        foreach ($restoretests as $restoretest) {
            if ($restoretest->get('reporef') == $params['uuid']) {
                throw new \OMV\Exception(gettext(
                    "Repository is in use. Please delete the restore tests associated with this repository first."
                ));
            }
        }

        $repo = $db->get('conf.service.restic.repo', $params['uuid']);

        // On request, remove the restic data files of a local repository from
        // its shared folder. Only done when the folder really holds a restic
        // repository (it has a `config` file), never for remote backends.
        if (!empty($params['deletedata']) && $repo->get('type') === 'local' &&
                !empty($repo->get('sharedfolderref'))) {
            try {
                $path = rtrim(\OMV\Rpc\Rpc::call('ShareMgmt', 'getPath', [
                    'uuid' => $repo->get('sharedfolderref')
                ], $context), '/');
            } catch (\Exception $e) {
                throw new \OMV\Exception(sprintf(gettext(
                    'Cannot delete the repository data, its shared folder could not be resolved: %s'),
                    $e->getMessage()));
            }
            if (is_file($path . '/config')) {
                foreach (["config", "data", "index", "keys", "locks", "snapshots"] as $item) {
                    $itemPath = $path . "/" . $item;
                    if (file_exists($itemPath)) {
                        $cmd = new \OMV\System\Process(['rm', '-rf', escapeshellarg($itemPath)]);
                        $cmd->execute();
                    }
                }
            }
        }

        $db->delete($repo);
        return $repo->getAssoc();
    }

    public function checkRepo($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['uuid']);
        return $this->execRepoCommands($repo, $context, [['check', '--retry-lock', '5m']]);
    }

    public function pruneRepo($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['uuid']);
        return $this->execRepoCommands($repo, $context, [['prune', '--retry-lock', '5m']]);
    }

    /**
     * Remove stale locks from a repository (`restic unlock`).
     */
    public function unlockRepo($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['uuid']);
        return $this->execRepoCommands($repo, $context, [['unlock']], "\nDone.\n");
    }

    /**
     * Verify connectivity and credentials for a repository by reading its
     * config (`restic cat config`). Fast and non-destructive.
     */
    public function testRepo($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['uuid']);
        return $this->execRepoCommands($repo, $context,
            [['cat', 'config', '--retry-lock', '5m']],
            "\nConnection successful: repository is reachable and the passphrase is correct.\n");
    }

    public function getRepoStats($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['uuid']);
        return $this->execRepoCommands($repo, $context, [['stats', '--retry-lock', '5m']]);
    }

    /**
     * List actual restic snapshots stored in the repository (not OMV backup job configs).
     */
    public function getRepoSnapshotList($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);

        $reporef = $params['reporef'] ?? null;
        if (empty($reporef)) {
            throw new \OMV\Exception(gettext("A repository must be specified."));
        }

        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $reporef);

        $cmdArgs = $this->addRepoOptions($repo,
            [$this->getProgram, 'snapshots', '--json', '--retry-lock', '5m']);
        $cmd = new \OMV\System\Process($cmdArgs);
        $this->buildRepoEnv($repo, $context, $cmd);
        // Keep stderr out of stdout, which must hold only the JSON, but keep
        // it so a failure (wrong passphrase, lock, unreachable backend) is
        // reported instead of looking like an empty repository.
        $errFile = tempnam(sys_get_temp_dir(), 'restic-snapshots-');
        $cmd->setRedirect2toFile(escapeshellarg($errFile));
        $cmd->setQuiet(true);
        $cmd->execute($output, $exitStatus);
        $errOutput = trim(@file_get_contents($errFile) ?: '');
        @unlink($errFile);
        if ($exitStatus !== 0) {
            throw new \OMV\ExecException($this->displayCommand($cmdArgs),
                explode("\n", $errOutput), $exitStatus);
        }

        $snapshots = [];
        if (!empty($output)) {
            $raw = implode('', $output);
            // Find the start of the JSON array in case any preamble text was emitted.
            $jsonStart = strpos($raw, '[');
            if ($jsonStart !== false) {
                $raw = substr($raw, $jsonStart);
            }
            $parsed = json_decode($raw, true);
            if (is_array($parsed)) {
                $snapshots = $parsed;
            }
        }

        // Normalise for datatable: ensure required fields exist
        foreach ($snapshots as &$s) {
            $s['id_short']  = isset($s['id']) ? substr($s['id'], 0, 8) : '';
            $s['paths_str'] = isset($s['paths'])   ? implode(', ', $s['paths'])   : '';
            $s['tags_str']  = isset($s['tags'])     ? implode(', ', $s['tags'])    : '';
            $s['hostname']  = $s['hostname'] ?? '';
            $s['username']  = $s['username'] ?? '';
            // Reformat ISO timestamp for readability
            if (!empty($s['time'])) {
                try {
                    $dt = new \DateTime($s['time']);
                    $s['time_formatted'] = $dt->format('Y-m-d H:i:s');
                } catch (\Exception $e) {
                    $s['time_formatted'] = $s['time'];
                }
            } else {
                $s['time_formatted'] = '';
            }
        }
        unset($s);

        // Apply standard list filtering / pagination
        $start      = $params['start']     ?? 0;
        $limit      = $params['limit']     ?? -1;
        $sortfield  = $params['sortfield'] ?? 'time';
        $sortdir    = $params['sortdir']   ?? 'desc';

        return $this->applyFilter($snapshots, $start, $limit, $sortfield, $sortdir);
    }

    /**
     * Load a repository and validate a restic snapshot ID taken from
     * $params['reporef'] / $params['snapshotid'].
     */
    private function getRepoAndSnapshotId($params)
    {
        $this->validateMethodParams($params, 'rpc.restic.reposnapshot');
        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['reporef']);
        return [$repo, $params['snapshotid']];
    }

    /**
     * Run a list of restic commands against a repository in a background
     * process, streaming each command's output into the task dialog. The
     * task fails at the first command that fails; $doneMessage is written
     * only once every command succeeded.
     */
    private function execRepoCommands($repo, $context, array $cmds, $doneMessage = null)
    {
        return $this->execBgProc(function ($bgStatusFilename, $bgOutputFilename) use ($context, $repo, $cmds, $doneMessage) {
            $output = [];
            foreach ($cmds as $i => $cmdArgs) {
                $cmdArgs = $this->addRepoOptions($repo, array_merge([$this->getProgram], $cmdArgs));
                $cmd = new \OMV\System\Process($cmdArgs);
                $this->buildRepoEnv($repo, $context, $cmd);
                $cmd->setRedirect2to1();
                $cmdLine = $cmd->getCommandLine();
                $this->writeBgProcOutput($bgOutputFilename,
                    sprintf("%sCommand: %s\n\n", ($i > 0 ? "\n\n" : ''),
                        $this->displayCommand($cmdArgs)));
                // Stop at the first failure: running the remaining commands
                // against an unreachable or broken repository would only
                // keep this background task (and an engined worker) busy.
                $exitStatus = $this->exec($cmdLine, $output, $bgOutputFilename);
                if (0 !== $exitStatus) {
                    throw new \OMV\ExecException(
                        $this->displayCommand($cmdArgs), $output, $exitStatus);
                }
            }
            if (!is_null($doneMessage)) {
                $this->writeBgProcOutput($bgOutputFilename, $doneMessage);
            }
            return $output;
        });
    }

    /**
     * Show the metadata (`restic cat snapshot`) and size statistics
     * (`restic stats`) of a single snapshot.
     */
    public function inspectRepoSnapshot($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        [$repo, $id] = $this->getRepoAndSnapshotId($params);
        return $this->execRepoCommands($repo, $context, [
            ['cat', 'snapshot', '--retry-lock', '5m', $id],
            ['stats', '--retry-lock', '5m', '--mode', 'restore-size', $id],
            ['stats', '--retry-lock', '5m', '--mode', 'raw-data', $id],
        ]);
    }

    /**
     * List the files contained in a single snapshot (`restic ls --long`).
     */
    public function listRepoSnapshotFiles($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        [$repo, $id] = $this->getRepoAndSnapshotId($params);
        return $this->execRepoCommands($repo, $context, [
            ['ls', '--long', '--retry-lock', '5m', $id],
        ]);
    }

    /**
     * Forget (delete) one or more snapshots, given as a comma-separated list of
     * IDs, optionally pruning the data that is no longer referenced afterwards.
     */
    public function forgetRepoSnapshots($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.forgetreposnapshots');
        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['reporef']);
        $cmdArgs = ['forget', '--retry-lock', '5m'];
        if (!empty($params['prune'])) {
            $cmdArgs[] = '--prune';
        }
        // IDs are validated as hex by the schema, so they are shell-safe.
        $cmdArgs = array_merge($cmdArgs, array_unique(explode(',', $params['snapshotids'])));
        return $this->execRepoCommands($repo, $context, [$cmdArgs]);
    }

    /**
     * Build the `restic forget` arguments for a repository's retention
     * policy. Returns null when no keep-* rule is set, since restic would
     * then remove nothing.
     */
    private function buildRepoForgetArgs($repo)
    {
        $keep = [];
        foreach (['last', 'daily', 'weekly', 'monthly', 'yearly'] as $k) {
            $n = intval($repo->get('forgetkeep' . $k));
            if ($n > 0) {
                $keep[] = '--keep-' . $k;
                $keep[] = $n;
            }
        }
        if (empty($keep)) {
            return null;
        }
        $cmdArgs = array_merge(['forget', '--retry-lock', '5m'], $keep);
        if (!empty($repo->get('forgethost'))) {
            $cmdArgs[] = '--host';
            $cmdArgs[] = escapeshellarg($repo->get('forgethost'));
        }
        if (!empty($repo->get('forgettag'))) {
            $cmdArgs[] = '--tag';
            $cmdArgs[] = escapeshellarg($repo->get('forgettag'));
        }
        if ($repo->get('forgetprune')) {
            $cmdArgs[] = '--prune';
        }
        return $cmdArgs;
    }

    /**
     * Apply (or preview with a dry run) a repository's retention policy.
     */
    public function applyRepoForget($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.applyrepoforget');
        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['uuid']);
        $cmdArgs = $this->buildRepoForgetArgs($repo);
        if (is_null($cmdArgs)) {
            throw new \OMV\Exception(gettext(
                'No retention policy is configured for this repository. Edit the repository and set at least one keep value.'));
        }
        if ($params['dryrun']) {
            $cmdArgs[] = '--dry-run';
        }
        return $this->execRepoCommands($repo, $context, [$cmdArgs]);
    }

    // =========================================================================
    // Backup Jobs (called "Snapshots" for backward compatibility)
    // =========================================================================

    public function getSnapshotList($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.getlist');

        $db = \OMV\Config\Database::getInstance();
        $snapshots = $db->get('conf.service.restic.snapshot');

        $snapshotsAssoc = [];
        foreach ($snapshots as &$snapshotv) {
            // Add repo name
            try {
                $repo = $db->get('conf.service.restic.repo', $snapshotv->get('reporef'));
                $snapshotv->add('reponame', 'string', $repo->get('name'));
            } catch (\Exception $e) {
                $snapshotv->add('reponame', 'string', gettext('n/a'));
            }

            // Resolve source shared folder names
            $sharedfoldernames = [];
            $csvRefs = $snapshotv->get('csvsharedfolderrefs');
            $uuids = array_filter(array_map('trim', explode(',', $csvRefs)));
            foreach ($uuids as $uuid) {
                try {
                    $sharedfolder = $db->get('conf.system.sharedfolder', $uuid);
                    $sharedfoldernames[] = $sharedfolder->get('name');
                } catch (\Exception $e) {}
            }
            $snapshotv->add('sourcename', 'string', implode(', ', $sharedfoldernames));

            $snapshotAssoc = $snapshotv->getAssoc();
            // Override hash with flat-file value if present (avoids config DB writes on backup).
            $hashFile = '/var/lib/openmediavault/restic/hash-' . $snapshotAssoc['uuid'];
            if (file_exists($hashFile)) {
                $snapshotAssoc['hash'] = trim(file_get_contents($hashFile));
            }
            $snapshotAssoc['schedule'] = $this->buildCronSchedule($snapshotAssoc, 'daily');
            $snapshotsAssoc[] = $snapshotAssoc;
        }
        unset($snapshotv);

        return $this->applyFilter(
            $snapshotsAssoc, $params['start'], $params['limit'],
            $params['sortfield'], $params['sortdir']
        );
    }

    public function getSnapshot($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');
        $db = \OMV\Config\Database::getInstance();
        $obj = $db->getAssoc('conf.service.restic.snapshot', $params['uuid']);
        // Convert CSV back to array so the multi-select form field populates correctly
        $obj['sharedfolderrefs'] = array_values(array_filter(array_map('trim', explode(',', $obj['csvsharedfolderrefs'] ?? ''))));
        // Convert comma-separated schedule strings to arrays for the multi-select fields
        foreach (['minute', 'hour', 'dayofmonth', 'month', 'dayofweek'] as $field) {
            $obj[$field] = array_values(array_filter(array_map('trim', explode(',', $obj[$field] ?? '*'))));
        }
        return $obj;
    }

    public function setSnapshot($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.setsnapshot');

        $params['sharedfolderrefs'] = $params['sharedfolderrefs'] ?? [];
        foreach (['excludelist', 'fileslist'] as $field) {
            // One entry per line; reject other control characters.
            $params[$field] = trim(str_replace(["\r\n", "\r"], "\n", $params[$field] ?? ''));
            if (preg_match('/[\x00-\x08\x0b-\x1f\x7f]/', $params[$field])) {
                throw new \OMV\Exception(gettext(
                    'The exclude and include lists must not contain control characters.'));
            }
        }
        $files = $this->parseJobList($params['fileslist']);
        foreach ($files as $path) {
            if ($path[0] !== '/') {
                throw new \OMV\Exception(sprintf(gettext(
                    "Invalid include path '%s'. Use one absolute path per line."), $path));
            }
        }
        if (empty($params['sharedfolderrefs']) && empty($files)) {
            throw new \OMV\Exception(gettext(
                'Select at least one source folder or add paths to the include list.'));
        }

        // Convert sharedfolderrefs array → CSV string for storage
        $csvRefs = '';
        foreach ($params['sharedfolderrefs'] as $i => $uuid) {
            $csvRefs .= ($i > 0 ? ', ' : '') . $uuid;
        }
        unset($params['sharedfolderrefs']);
        $params['csvsharedfolderrefs'] = $csvRefs;

        $this->normaliseSchedule($params);

        // Apply default values for optional fields that may be missing
        $params['enable']    = $params['enable'] ?? true;
        $params['name']      = $params['name']   ?? '';
        $params['execution'] = $params['execution'] ?? 'daily';
        $params['keeplast']   = isset($params['keeplast'])    ? intval($params['keeplast'])    : 0;
        $params['keepdaily']  = isset($params['keepdaily'])   ? intval($params['keepdaily'])   : 7;
        $params['keepweekly'] = isset($params['keepweekly'])  ? intval($params['keepweekly'])  : 4;
        $params['keepmonthly']= isset($params['keepmonthly']) ? intval($params['keepmonthly']) : 12;
        $params['keepyearly'] = isset($params['keepyearly'])  ? intval($params['keepyearly'])  : 0;
        $params['sendemail']    = $params['sendemail']    ?? false;
        $params['emailonerror'] = $params['emailonerror'] ?? false;
        $params['prescript']    = trim($params['prescript']  ?? '');
        $params['postscript']   = trim($params['postscript'] ?? '');

        $db = \OMV\Config\Database::getInstance();
        $snapshot = new \OMV\Config\ConfigObject('conf.service.restic.snapshot');
        $snapshot->setAssoc($params);
        $db->set($snapshot);
        return $snapshot->getAssoc();
    }

    /**
     * Run a backup job in a background task. $params is a stored backup job
     * (see runSnapshot), so this is deliberately not an RPC method.
     *
     * A dry run only reports what would be backed up: it skips the hook
     * scripts (they may stop services), the "last snapshot" hash and the
     * retention policy. $listFiles prints every file instead of a summary.
     */
    private function runBackup($params, $context, $dryRun = false, $listFiles = false)
    {
        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['reporef']);

        return $this->execBgProc(function ($bgStatusFilename, $bgOutputFilename) use ($params, $context, $repo, $dryRun, $listFiles) {
            $listFileNames = [];
            try {
                $cmdArgs = [$this->getProgram, 'backup',
                    ($dryRun && $listFiles) ? '-vv' : '--verbose', '--retry-lock', '5m'];
                if ($dryRun) {
                    $cmdArgs[] = '--dry-run';
                }

                // Tags (ignore empty strings)
                $tags = array_filter(array_map('trim', explode(',', $params['tags'] ?? '')));
                foreach ($tags as $tag) {
                    $cmdArgs[] = '--tag ' . escapeshellarg($tag);
                }

                // Excludes
                $excludes = array_filter(array_map('trim', explode(',', $params['exclude'] ?? '')));
                foreach ($excludes as $excl) {
                    $cmdArgs[] = '--exclude ' . escapeshellarg($excl);
                }

                // Default excludes from the plugin settings (apply to every job)
                $settings = \OMV\Config\Database::getInstance()->get('conf.service.restic.settings');
                // The file is written by salt, so it only exists once the settings
                // have been applied.
                if (!empty(trim($settings->get('exclude'))) && file_exists($this->defaultExcludeFile)) {
                    $cmdArgs[] = '--exclude-file ' . escapeshellarg($this->defaultExcludeFile);
                }
                if ($settings->get('excludecaches')) {
                    $cmdArgs[] = '--exclude-caches';
                }

                // Advanced per-job lists, written to temp files from the stored
                // job so they apply even before the configuration is deployed.
                foreach (['excludelist' => '--exclude-file', 'fileslist' => '--files-from'] as $field => $flag) {
                    $entries = $this->parseJobList($params[$field] ?? '');
                    if (empty($entries)) {
                        continue;
                    }
                    $listFile = tempnam(sys_get_temp_dir(), 'restic-' . $field . '-');
                    $listFileNames[] = $listFile;
                    file_put_contents($listFile, implode("\n", $entries) . "\n");
                    $cmdArgs[] = $flag . ' ' . escapeshellarg($listFile);
                }
                if (empty($params['sharedfolderrefs'])) {
                    $cmdArgs[] = '--tag ' . escapeshellarg($this->jobTag($params['uuid']));
                }

                // Source paths
                foreach ($params['sharedfolderrefs'] as $uuid) {
                    $sfpath = \OMV\Rpc\Rpc::call("ShareMgmt", "getPath", ["uuid" => $uuid], $context);
                    $cmdArgs[] = escapeshellarg($sfpath);
                }

                if ($dryRun) {
                    $cmdArgs = $this->addRepoOptions($repo, $cmdArgs);
                    $cmd = new \OMV\System\Process($cmdArgs);
                    $this->buildRepoEnv($repo, $context, $cmd);
                    $cmd->setRedirect2to1();
                    $this->writeBgProcOutput($bgOutputFilename, sprintf(
                        "Dry run, nothing is written to the repository.\nCommand: %s\n\n",
                        $this->displayCommand($cmdArgs)));
                    $exit = $this->exec($cmd->getCommandLine(), $output, $bgOutputFilename);
                    if ($exit !== 0) {
                        throw new \OMV\ExecException($this->displayCommand($cmdArgs), $output, $exit);
                    }
                    return $output;
                }

                // A failing pre-script skips the backup; the post-script still
                // runs so it can undo whatever the pre-script did.
                $preExit = $this->runHookScript('pre-script', $params['prescript'] ?? '',
                    $repo, $context, $bgOutputFilename);
                if ($preExit !== 0) {
                    $this->runHookScript('post-script', $params['postscript'] ?? '',
                        $repo, $context, $bgOutputFilename, $preExit);
                    throw new \OMV\Exception(sprintf(
                        'Pre-script failed with exit code %d, backup skipped.', $preExit));
                }

                $cmdArgs = $this->addRepoOptions($repo, $cmdArgs);
                $cmd = new \OMV\System\Process($cmdArgs);
                $this->buildRepoEnv($repo, $context, $cmd);
                $cmd->setRedirect2to1();
                $cmdLine = $cmd->getCommandLine();

                $this->writeBgProcOutput($bgOutputFilename, sprintf("Command: %s\n\n", $this->displayCommand($cmdArgs)));
                $backupExit = $this->exec($cmdLine, $output, $bgOutputFilename);

                $postExit = $this->runHookScript('post-script', $params['postscript'] ?? '',
                    $repo, $context, $bgOutputFilename, $backupExit);

                // A failed backup must fail the task, and must not go on to apply
                // retention: forgetting old snapshots right after a failed backup
                // could leave fewer good snapshots than the policy intends.
                if ($backupExit !== 0) {
                    throw new \OMV\ExecException($this->displayCommand($cmdArgs),
                        $output, $backupExit);
                }

                // Extract the snapshot hash from the backup output
                preg_match('/snapshot ([0-9a-f]+) saved/', implode("\n", $output), $matches);
                $hash = isset($matches[1]) ? $matches[1] : '';

                // Persist the hash to a flat file (not the config DB) so we avoid
                // triggering an "Apply changes" notification on every backup run.
                // The scheduled script writes the same file.
                if (!empty($hash) && !empty($params['uuid'])) {
                    $hashDir = '/var/lib/openmediavault/restic';
                    if (!is_dir($hashDir)) {
                        mkdir($hashDir, 0700, true);
                    }
                    file_put_contents($hashDir . '/hash-' . $params['uuid'], $hash);
                }

                // Apply retention policy if configured
                $this->applyRetentionPolicy($params, $repo, $context, $bgOutputFilename);

                if ($postExit !== 0) {
                    throw new \OMV\Exception(sprintf(
                        'Post-script failed with exit code %d.', $postExit));
                }

                return $output;
            } finally {
                foreach ($listFileNames as $listFile) {
                    @unlink($listFile);
                }
            }
        });
    }

    /**
     * Manually trigger an existing backup job by UUID.
     */
    public function runSnapshot($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.runsnapshot');

        $db = \OMV\Config\Database::getInstance();
        $snapshot = $db->get('conf.service.restic.snapshot', $params['uuid']);

        // Convert CSV refs back to an array for runBackup
        $csvRefs = $snapshot->get('csvsharedfolderrefs');
        $refs = array_filter(array_map('trim', explode(',', $csvRefs)));

        $backupParams = $snapshot->getAssoc();
        $backupParams['sharedfolderrefs'] = array_values($refs);
        unset($backupParams['csvsharedfolderrefs']);

        return $this->runBackup($backupParams, $context,
            !empty($params['dryrun']), !empty($params['listfiles']));
    }

    /**
     * Delete a backup job. The snapshots it created stay in the repository:
     * they are often exactly what is needed for a restore after a job has
     * been removed. Use the repository's snapshot browser or retention
     * policy to forget them.
     */
    public function deleteSnapshot($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $snapshot = $db->get('conf.service.restic.snapshot', $params['uuid']);
        @unlink('/var/lib/openmediavault/restic/hash-' . $snapshot->get('uuid'));

        $db->delete($snapshot);
        return $snapshot->getAssoc();
    }

    /**
     * Restore a restic snapshot to a target shared folder.
     */
    public function restoreSnapshot($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.restoresnapshot');

        $db = \OMV\Config\Database::getInstance();
        $repo = $db->get('conf.service.restic.repo', $params['reporef']);

        $dryRun = !empty($params['dryrun']);
        if ($dryRun) {
            // A dry run writes nothing, but restic still requires a --target to
            // diff against. Point at a path that is never created or written to.
            $targetPath = '/var/lib/openmediavault-restic/dryrun';
        } else {
            if (empty($params['targetref'])) {
                throw new \OMV\Exception(
                    'A restore target folder is required.');
            }
            $targetPath = \OMV\Rpc\Rpc::call('ShareMgmt', 'getPath', [
                'uuid' => $params['targetref']
            ], $context);
        }

        return $this->execBgProc(function ($bgStatusFilename, $bgOutputFilename) use ($params, $context, $repo, $targetPath, $dryRun) {
            $cmdArgs = [
                $this->getProgram,
                'restore',
                '--retry-lock',
                '5m'
            ];

            // Preview only: report what would be restored without writing data.
            if ($dryRun) {
                $cmdArgs[] = '--dry-run';
                $cmdArgs[] = '--verbose=2';
            }

            $cmdArgs[] = escapeshellarg($params['snapshotid']);
            $cmdArgs[] = '--target';
            $cmdArgs[] = escapeshellarg($targetPath);

            // Optional path filter within the snapshot
            if (!empty($params['includepath'])) {
                $cmdArgs[] = '--include ' . escapeshellarg($params['includepath']);
            }

            $cmdArgs = $this->addRepoOptions($repo, $cmdArgs);
            $cmd = new \OMV\System\Process($cmdArgs);
            $this->buildRepoEnv($repo, $context, $cmd);
            $cmd->setRedirect2to1();
            $cmdLine = $cmd->getCommandLine();

            $this->writeBgProcOutput($bgOutputFilename, sprintf("Command: %s\n\n", $this->displayCommand($cmdArgs)));
            $exitStatus = $this->exec($cmdLine, $output, $bgOutputFilename);
            if ($exitStatus !== 0) {
                throw new \OMV\ExecException($this->displayCommand($cmdArgs),
                    $output, $exitStatus);
            }
            return $output;
        });
    }

    // =========================================================================
    // Restore Test Jobs (scheduled dry-run / verify restores)
    // =========================================================================

    public function getRestoreTestList($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.getlist');

        $db = \OMV\Config\Database::getInstance();
        $jobs = $db->get('conf.service.restic.restoretest');

        $jobsAssoc = [];
        foreach ($jobs as &$jobv) {
            // Resolve repository name
            try {
                $repo = $db->get('conf.service.restic.repo', $jobv->get('reporef'));
                $jobv->add('reponame', 'string', $repo->get('name'));
            } catch (\Exception $e) {
                $jobv->add('reponame', 'string', gettext('n/a'));
            }

            // Resolve target shared folder name (verify mode only)
            $targetname = '';
            if (!empty($jobv->get('targetref'))) {
                try {
                    $sf = $db->get('conf.system.sharedfolder', $jobv->get('targetref'));
                    $targetname = $sf->get('name');
                } catch (\Exception $e) {}
            }
            $jobv->add('targetname', 'string', $targetname);

            $jobAssoc = $jobv->getAssoc();
            $jobAssoc['schedule'] = $this->buildCronSchedule($jobAssoc, 'weekly');
            $jobsAssoc[] = $jobAssoc;
        }
        unset($jobv);

        return $this->applyFilter(
            $jobsAssoc, $params['start'], $params['limit'],
            $params['sortfield'], $params['sortdir']
        );
    }

    public function getRestoreTest($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');
        $db = \OMV\Config\Database::getInstance();
        $obj = $db->getAssoc('conf.service.restic.restoretest', $params['uuid']);
        // Convert comma-separated schedule strings to arrays for the multi-select fields
        foreach (['minute', 'hour', 'dayofmonth', 'month', 'dayofweek'] as $field) {
            $obj[$field] = array_values(array_filter(array_map('trim', explode(',', $obj[$field] ?? '*'))));
        }
        return $obj;
    }

    public function setRestoreTest($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.setrestoretest');

        $this->normaliseSchedule($params);

        // Apply default values for optional fields that may be missing
        $params['enable']      = $params['enable']      ?? true;
        $params['name']        = $params['name']        ?? '';
        $params['mode']        = $params['mode']        ?? 'dryrun';
        $params['targetref']   = $params['targetref']   ?? '';
        $params['cleanup']     = $params['cleanup']     ?? true;
        $params['includepath']  = $params['includepath']  ?? '';
        $params['execution']    = $params['execution']    ?? 'weekly';
        $params['sendemail']    = $params['sendemail']    ?? false;
        $params['emailonerror'] = $params['emailonerror'] ?? false;
        $params['prescript']    = trim($params['prescript']  ?? '');
        $params['postscript']   = trim($params['postscript'] ?? '');

        // A verify restore writes files to disk, so it needs a target folder.
        if ($params['mode'] === 'verify' && empty($params['targetref'])) {
            throw new \OMV\Exception(
                'A verify restore test requires a target shared folder.');
        }

        $db = \OMV\Config\Database::getInstance();
        $job = new \OMV\Config\ConfigObject('conf.service.restic.restoretest');
        $job->setAssoc($params);
        $db->set($job);
        return $job->getAssoc();
    }

    public function deleteRestoreTest($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $job = $db->get('conf.service.restic.restoretest', $params['uuid']);
        $db->delete($job);
        return $job->getAssoc();
    }

    /**
     * Manually trigger a restore test by UUID. Runs `restic restore latest`
     * in either dry-run (preview, no data written) or verify (full restore
     * with content verification) mode, optionally cleaning up afterwards.
     */
    public function runRestoreTest($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.objectuuid');

        $db = \OMV\Config\Database::getInstance();
        $job = $db->get('conf.service.restic.restoretest', $params['uuid']);
        $repo = $db->get('conf.service.restic.repo', $job->get('reporef'));

        $mode = $job->get('mode');
        $includePath = $job->get('includepath');
        $cleanup = $job->get('cleanup');

        // Resolve the restore target. For verify mode this is a per-job
        // subdirectory inside the selected shared folder, so cleanup only ever
        // removes data we created. For dry-run nothing is written, but restic
        // still requires a --target, so we point at a path that never exists.
        if ($mode === 'verify') {
            if (empty($job->get('targetref'))) {
                throw new \OMV\Exception(
                    'A verify restore test requires a target shared folder.');
            }
            $base = \OMV\Rpc\Rpc::call('ShareMgmt', 'getPath', [
                'uuid' => $job->get('targetref')
            ], $context);
            $targetPath = rtrim($base, '/') . '/restic-restoretest-' . $job->get('uuid');
        } else {
            $targetPath = '/var/lib/openmediavault-restic/dryrun';
        }

        $prescript = $job->get('prescript');
        $postscript = $job->get('postscript');

        return $this->execBgProc(function ($bgStatusFilename, $bgOutputFilename) use ($context, $repo, $mode, $includePath, $cleanup, $targetPath, $prescript, $postscript) {
            $preExit = $this->runHookScript('pre-script', $prescript,
                $repo, $context, $bgOutputFilename);
            if ($preExit !== 0) {
                $this->runHookScript('post-script', $postscript,
                    $repo, $context, $bgOutputFilename, $preExit);
                throw new \OMV\Exception(sprintf(
                    'Pre-script failed with exit code %d, restore test skipped.', $preExit));
            }

            $cmdArgs = [
                $this->getProgram,
                'restore',
                '--retry-lock',
                '5m'
            ];
            if ($mode === 'verify') {
                $cmdArgs[] = '--verify';
            } else {
                $cmdArgs[] = '--dry-run';
                $cmdArgs[] = '--verbose=2';
            }
            $cmdArgs[] = 'latest';
            $cmdArgs[] = '--target';
            $cmdArgs[] = escapeshellarg($targetPath);
            if (!empty($includePath)) {
                $cmdArgs[] = '--include ' . escapeshellarg($includePath);
            }

            $cmdArgs = $this->addRepoOptions($repo, $cmdArgs);
            $cmd = new \OMV\System\Process($cmdArgs);
            $this->buildRepoEnv($repo, $context, $cmd);
            $cmd->setRedirect2to1();
            $cmdLine = $cmd->getCommandLine();

            $this->writeBgProcOutput($bgOutputFilename, sprintf("Command: %s\n\n", $this->displayCommand($cmdArgs)));
            $restoreExit = $this->exec($cmdLine, $output, $bgOutputFilename);

            // Remove the restored data (verify mode only). We only ever delete
            // the per-job subdirectory created above, never the shared folder.
            if ($mode === 'verify' && $cleanup) {
                $this->writeBgProcOutput($bgOutputFilename, "\nCleaning up restored data ...\n");
                $this->exec('rm -rf ' . escapeshellarg($targetPath) . ' 2>&1', $rmOutput, $bgOutputFilename);
            }

            $postExit = $this->runHookScript('post-script', $postscript,
                $repo, $context, $bgOutputFilename, $restoreExit);
            // The restore result is what the test is for, so it takes
            // precedence over a failing post-script.
            if ($restoreExit !== 0) {
                throw new \OMV\ExecException($this->displayCommand($cmdArgs),
                    $output, $restoreExit);
            }
            if ($postExit !== 0) {
                throw new \OMV\Exception(sprintf(
                    'Post-script failed with exit code %d.', $postExit));
            }

            return $output;
        });
    }

    // =========================================================================
    // REST server (serves a shared folder to remote restic clients)
    // =========================================================================

    public function getRestServer($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $db = \OMV\Config\Database::getInstance();
        return $db->getAssoc('conf.service.restic.restserver');
    }

    public function setRestServer($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.restic.setrestserver');

        $params['privaterepos'] = $params['privaterepos'] ?? false;
        $params['appendonly'] = $params['appendonly'] ?? false;
        $params['tls'] = $params['tls'] ?? false;
        $params['sslcertificateref'] = $params['sslcertificateref'] ?? '';

        if ($params['enable'] && empty($params['sharedfolderref'])) {
            throw new \OMV\Exception(
                gettext('A shared folder is required to enable the REST server.'));
        }
        if ($params['tls'] && empty($params['sslcertificateref'])) {
            throw new \OMV\Exception(
                gettext('A certificate is required when TLS is enabled.'));
        }
        // Private repositories are keyed by the authenticated username.
        if ($params['privaterepos'] && !$params['auth']) {
            throw new \OMV\Exception(
                gettext('Private repositories require authentication.'));
        }

        $db = \OMV\Config\Database::getInstance();
        $object = $db->get('conf.service.restic.restserver');
        $object->setAssoc($params);
        $db->set($object);
        return $object->getAssoc();
    }

    public function getRestUserList($params, $context)
    {
        $this->validateMethodContext($context, ['role' => OMV_ROLE_ADMINISTRATOR]);
        $this->validateMethodParams($params, 'rpc.common.getlist');

        $db = \OMV\Config\Database::getInstance();
        $objectsAssoc = [];
        foreach ($db->get('conf.service.restic.restuser') as $user) {
            // Never hand password hashes to the UI.
            $objectsAssoc[] = [
