#!/bin/sh

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

remove_action() {
    dpkg-trigger update-workbench
}


case "$1" in
    purge)
        remove_action
        # Remove the configuration data.
        omv_config_delete "/config/services/restic"
    ;;

    remove)
        remove_action
        # remove restic confs
        rm -rf /var/lib/openmediavault/restic
        # remove cron.d file
        rm -f /etc/cron.d/openmediavault-restic
        # stop the REST server the plugin configured and drop our overrides;
        # the restic-rest-server package itself is left installed
        if [ -e /etc/systemd/system/restic-rest-server.service.d/openmediavault.conf ]; then
            deb-systemd-invoke stop restic-rest-server.service >/dev/null 2>&1 || :
            systemctl disable restic-rest-server.service >/dev/null 2>&1 || :
            rm -f /etc/systemd/system/restic-rest-server.service.d/openmediavault.conf
            rmdir --ignore-fail-on-non-empty /etc/systemd/system/restic-rest-server.service.d 2>/dev/null || :
            systemctl daemon-reload >/dev/null 2>&1 || :
        fi
        rm -f /etc/restic/rest-server.htpasswd /etc/restic/exclude-default
    ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0